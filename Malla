// ===================== LÓGICA =====================
let aprobadas = new Set(JSON.parse(localStorage.getItem("aprobadas") || "[]"));

function puedeCursar(m) {
  return m.requisitos.every(r => aprobadas.has(r));
}

function toggleMateria(id) {
  const materia = materias.find(m => m.id === id);
  if (!puedeCursar(materia)) return;

  aprobadas.has(id) ? aprobadas.delete(id) : aprobadas.add(id);
  localStorage.setItem("aprobadas", JSON.stringify([...aprobadas]));
  render();
}

function render() {
  const malla = document.getElementById("malla");
  malla.innerHTML = "";

  let total = 0;
  const semestres = [...new Set(materias.map(m => m.semestre))];

  semestres.forEach(s => {
    const div = document.createElement("div");
    div.className = "semestre";
    div.dataset.semestre = s;

    const h2 = document.createElement("h2");
    h2.textContent = `Semestre ${s}`;
    div.appendChild(h2);

    let sumaSemestre = 0;

    materias.filter(m => m.semestre === s).forEach(m => {
      const el = document.createElement("div");
      el.className = "materia";
      el.textContent = `${m.nombre} (${m.creditos} cr)`;

      if (!puedeCursar(m)) el.classList.add("bloqueada");
      if (aprobadas.has(m.id)) {
        el.classList.add("aprobada");
        sumaSemestre += m.creditos;
        total += m.creditos;
      }

      el.onclick = () => toggleMateria(m.id);
      div.appendChild(el);
    });

    const p = document.createElement("p");
    p.textContent = `Créditos aprobados: ${sumaSemestre}`;
    div.appendChild(p);

    malla.appendChild(div);
  });

  document.getElementById("total-creditos").textContent = total;
}

render();
